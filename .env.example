PROJECT_NAME="Prism Network"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
JWT_SECRET="prism-super-secret-key-change-in-production-min32chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database
DATABASE_URL="sqlite:///D:/prism-network/data/prism.db"

# Working Hours (24-hour format)
WORK_HOUR_START=9
WORK_HOUR_END=18

# Risk & Alert Thresholds
ALERT_THRESHOLD=45.0
CRITICAL_THRESHOLD=80.0
BULK_DOWNLOAD_THRESHOLD=10
REQUEST_RATE_THRESHOLD=15.0

# Detection Weights (ML contribution: 0-40, Rule contribution: 0-60)
ML_WEIGHT=40.0
RULE_WEIGHT=60.0
